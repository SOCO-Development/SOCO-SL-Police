# Copy to .env.local and adjust for your environment:
#   cp .env.example .env.local

# Browser calls this same-origin path (avoids CORS in dev & IIS deployments)
NEXT_PUBLIC_API_BASE_URL=/soco-api

# Real backend URL — dev proxy + IIS rewrite target (not exposed to browser)
API_BACKEND_URL=http://220.247.224.226:8409/SocoApi/api

# Optional: public site URL for metadata/favicons in production
# NEXT_PUBLIC_SITE_URL=https://your-soco-host.example.gov.lk

# Optional: IIS subpath hosting (e.g. /MyApp) — rebuild after changing
# NEXT_PUBLIC_BASE_PATH=
