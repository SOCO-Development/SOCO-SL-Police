<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting for the Next.js STATIC EXPORT (output: 'export').

  The deployed site is the contents of the `out/` folder (this file is copied there
  by `npm run build`). There is NO Node server in production - IIS serves the
  pre-rendered HTML and static assets directly.

  Prerequisites on the Windows server:
  - "IIS URL Rewrite Module" installed (for the /soco-api proxy).
  - "Application Request Routing" (ARR) installed + proxy enabled
      (IIS Manager → server node → Application Request Routing Cache →
       Server Proxy Settings → Enable proxy)  -- only needed for the /soco-api proxy.
  - The site's physical path must point at the `out/` folder.

  With trailingSlash:true every page is exported as `<route>/index.html`, so refresh /
  back / forward resolve to a real folder + default document (no more 403).
-->
<configuration>
  <system.web>
    <httpRuntime enableVersionHeader="false" />
  </system.web>
  <system.webServer>
    <security>
      <requestFiltering removeServerHeader="true" />
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
      </customHeaders>
    </httpProtocol>

    <!-- Serve index.html when a folder route is requested (/, /home/, ...). -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- Correct MIME types for assets emitted by the export. -->
    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>

    <!-- gzip/brotli for faster responses. -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <rewrite>
      <rules>
        <!-- Forward /soco-api/* to the SOCO backend (same-origin for the browser, no CORS). -->
        <rule name="SocoApi-Proxy" stopProcessing="true">
          <match url="^soco-api/(.*)" />
          <action type="Rewrite" url="http://220.247.224.226:8409/SocoApi/api/{R:1}" />
        </rule>

        <!-- Extensionless URL with no matching file/folder -> serve the exported <url>.html. -->
        <rule name="StaticHtmlExtension" stopProcessing="true">
          <match url="^(.*)$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_FILENAME}.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}.html" />
        </rule>

        <!-- Anything still unmatched -> the exported 404 page. -->
        <rule name="StaticNotFound" stopProcessing="true">
          <match url="^(.*)$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/404.html" />
        </rule>
      </rules>
    </rewrite>

    <httpErrors existingResponse="PassThrough" />
  </system.webServer>

  <!-- Hashed build assets never change -> cache them for a year. -->
  <location path="_next/static">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
